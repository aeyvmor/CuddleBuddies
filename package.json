{
  "name": "astig",
  "private": true,
  "type": "module",
  "description": "ASTIG hackathon MVP monorepo (npm workspaces).",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "workspaces": [
    "apps/web",
    "packages/contracts",
    "packages/domain",
    "database",
    "services/api",
    "services/worker",
    "infra/aws"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "npm run typecheck -w @astig/web",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:web": "npm test -w @astig/web",
    "build:web": "npm run build -w @astig/web",
    "web:dev": "npm run dev -w @astig/web",
    "db:up": "docker compose -f database/local/compose.yaml up -d --wait",
    "db:down": "docker compose -f database/local/compose.yaml down",
    "db:migrate": "npm run migrate -w @astig/database",
    "db:seed": "npm run seed -w @astig/database",
    "db:reset": "npm run reset -w @astig/database",
    "api:dev": "npm run dev -w @astig/api",
    "cdk:synth": "npm run synth -w @astig/infra-aws"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
