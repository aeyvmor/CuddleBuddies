# Copy to `.env` (ignored) for local development. Never commit real values.
# Local Docker PostGIS (see database/local/compose.yaml). Port 5433 avoids clashing with a host Postgres on 5432.
DATABASE_URL=postgres://astig:astig_local_only@localhost:5433/astig
# Separate database used by `npm run test:db`; it is DROPPED and recreated on every run.
TEST_DATABASE_URL=postgres://astig:astig_local_only@localhost:5433/astig_test

# API auth mode: `jwt` (API Gateway JWT authorizer claims) or `local-dev` (trusted dev headers; refused inside Lambda/production).
ASTIG_AUTH_MODE=local-dev
API_PORT=3001
